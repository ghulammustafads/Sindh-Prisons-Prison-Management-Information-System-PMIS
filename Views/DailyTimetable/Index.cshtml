@model PrisonManagementSystem.ViewModels.TimetableViewModel
@{
    ViewData["Title"] = "Daily Timetable";
    ViewData["ActivePage"] = "Daily Timetable";
    Layout = "_AuthenticatedLayout";
}

<div class="page-title-block">
    <h2 class="page-title">Daily Timetable</h2>
    <p class="page-subtitle">Manage daily jail activities.</p>
</div>

<partial name="_Alerts" model="Model" />

<div class="two-column-workspace">
    <!-- Left: Activity list card -->
    <div class="pmis-card">
        <div class="table-filter-bar">
            <form method="get" asp-controller="DailyTimetable" asp-action="Index" class="filter-left-group">
                <div class="date-range-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <span>Activities for</span>
                </div>
                <select name="day" class="form-select" style="width: 170px;" onchange="this.form.submit()">
                    <option value="">All days</option>
                    <option value="1" selected="@(Model.SelectedDay == 1)">Monday</option>
                    <option value="2" selected="@(Model.SelectedDay == 2)">Tuesday</option>
                    <option value="3" selected="@(Model.SelectedDay == 3)">Wednesday</option>
                    <option value="4" selected="@(Model.SelectedDay == 4)">Thursday</option>
                    <option value="5" selected="@(Model.SelectedDay == 5)">Friday</option>
                    <option value="6" selected="@(Model.SelectedDay == 6)">Saturday</option>
                    <option value="7" selected="@(Model.SelectedDay == 7)">Sunday</option>
                </select>
            </form>

            <a href="#activityFormCard" class="btn-green-action">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <span>Add activity</span>
            </a>
        </div>

        @if (Model.Activities.Count > 0)
        {
            <div class="pmis-table-wrapper">
                <table class="pmis-table">
                    <thead>
                        <tr>
                            <th>Activity</th>
                            <th>Day</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Barrack</th>
                            <th>Responsible staff</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Activities)
                        {
                            var dayLabel = a.DayOfWeek switch
                            {
                                1 => "Monday",
                                2 => "Tuesday",
                                3 => "Wednesday",
                                4 => "Thursday",
                                5 => "Friday",
                                6 => "Saturday",
                                7 => "Sunday",
                                _ => "Daily"
                            };

                            <tr>
                                <td style="font-weight: 500;">@a.ActivityName</td>
                                <td>@dayLabel</td>
                                <td>@a.StartTime.ToString(@"hh\:mm")</td>
                                <td>@a.EndTime.ToString(@"hh\:mm")</td>
                                <td>@(a.Barrack != null ? a.Barrack.BarrackName : "Jail-wide")</td>
                                <td>@(a.ResponsibleStaff != null ? a.ResponsibleStaff.FullName : "—")</td>
                                <td>
                                    <div style="display: flex; gap: 6px;">
                                        <a asp-action="Index" asp-route-day="@Model.SelectedDay" asp-route-editId="@a.TimetableID" class="btn-table-action">
                                            Edit
                                        </a>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Remove this activity from timetable?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@a.TimetableID" />
                                            <input type="hidden" name="day" value="@Model.SelectedDay" />
                                            <button type="submit" class="btn-table-action" style="color: var(--pmis-danger);">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state-container">
                <div class="empty-state-icon-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="empty-state-label">No activities scheduled</div>
            </div>
        }
    </div>

    <!-- Right: Add / Edit activity form card -->
    <div class="pmis-card" id="activityFormCard">
        <div class="card-header-bar">
            <div class="card-title-icon-group">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                <span>@(Model.Form.TimetableID > 0 ? "Edit activity" : "Add activity")</span>
            </div>
        </div>

        <form asp-action="Save" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.TimetableID" />
            <input type="hidden" asp-for="SelectedDay" />
            @if (Model.Form.RowVersion != null)
            {
                <input type="hidden" name="Form.RowVersion" value="@Convert.ToBase64String(Model.Form.RowVersion)" />
            }

            <div class="form-group">
                <label asp-for="Form.ActivityName" class="form-label">Activity name</label>
                <input asp-for="Form.ActivityName" class="form-input" required />
                <span asp-validation-for="Form.ActivityName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Form.DayOfWeek" class="form-label">Day</label>
                <select asp-for="Form.DayOfWeek" class="form-select">
                    <option value="">Daily (All days)</option>
                    <option value="1">Monday</option>
                    <option value="2">Tuesday</option>
                    <option value="3">Wednesday</option>
                    <option value="4">Thursday</option>
                    <option value="5">Friday</option>
                    <option value="6">Saturday</option>
                    <option value="7">Sunday</option>
                </select>
            </div>

            <div class="form-row-2col form-group">
                <div>
                    <label asp-for="Form.StartTime" class="form-label">Start time</label>
                    <input asp-for="Form.StartTime" type="time" class="form-input" required />
                    <span asp-validation-for="Form.StartTime" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Form.EndTime" class="form-label">End time</label>
                    <input asp-for="Form.EndTime" type="time" class="form-input" required />
                    <span asp-validation-for="Form.EndTime" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Form.BarrackID" class="form-label">Barrack</label>
                <select asp-for="Form.BarrackID" class="form-select">
                    <option value="">Jail-wide / All barracks</option>
                    @foreach (var b in Model.AvailableBarracks)
                    {
                        <option value="@b.BarrackID">@b.BarrackName (@b.Category)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Form.ResponsibleStaffID" class="form-label">Responsible staff</label>
                <select asp-for="Form.ResponsibleStaffID" class="form-select">
                    <option value="">Select staff</option>
                    @foreach (var s in Model.AvailableStaff)
                    {
                        <option value="@s.StaffID">@s.FullName (@s.OfficialRank)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Form.Instructions" class="form-label">Instructions</label>
                <textarea asp-for="Form.Instructions" class="form-textarea" placeholder="Operational details, movement protocol, or security instructions"></textarea>
            </div>

            <button type="submit" class="btn-green-submit">
                Save activity
            </button>

            @if (Model.Form.TimetableID > 0)
            {
                <div style="text-align: center; margin-top: 10px;">
                    <a asp-action="Index" asp-route-day="@Model.SelectedDay" style="font-size: 13px; color: var(--pmis-navy-sub); text-decoration: none;">
                        Cancel edit
                    </a>
                </div>
            }
        </form>
    </div>
</div>
