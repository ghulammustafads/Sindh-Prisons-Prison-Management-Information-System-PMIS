@model PrisonManagementSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_Layout";
}

<div class="login-page-container">
    <div class="login-card">
        <div class="login-header">
            <h1 class="login-system-title">Sindh Prisons</h1>
            <p class="login-system-sub">Prison Management Information System</p>
        </div>

        <h2 class="login-form-heading">Sign in</h2>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="pmis-alert pmis-alert-danger" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form action="/Account/Login" method="post" autocomplete="off">

            <div class="form-group">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-input" autofocus required />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="password-input-group">
                    <input asp-for="Password" type="password" id="passwordInput" class="form-input" required />
                    <button type="button" id="togglePasswordBtn" class="password-toggle-btn" aria-label="Toggle password visibility">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-green-submit" style="margin-top: 24px;">
                Sign in
            </button>
        </form>


        <div class="login-footer-notice">
            Authorized personnel only.
        </div>
    </div>
</div>
