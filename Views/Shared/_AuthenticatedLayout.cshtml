@{
    Layout = "_Layout";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
    var initials = RoleConstants.GetInitials(userRole);
    var activePageTitle = (ViewData["ActivePage"] as string) ?? (ViewData["Title"] as string) ?? "Dashboard";
}

<div class="app-container">
    <!-- Left Sidebar: Exactly Two Items (Current Page Non-navigating Label + Sign out) -->
    <aside class="app-sidebar">
        <div>
            <div class="sidebar-branding">
                <h1 class="branding-title">Sindh Prisons</h1>
                <p class="branding-subtitle">Corrections Service</p>
            </div>

            <nav class="sidebar-menu">
                <!-- 1. Current Page Name Displayed as a Non-navigating Label -->
                <div class="sidebar-item-active">
                    @if (userRole == RoleConstants.JailSuperintendent)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        <span>Dashboard</span>
                    }
                    else if (userRole == RoleConstants.TimetableOfficer)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span>Daily Timetable</span>
                    }
                    else if (userRole == RoleConstants.Gatekeeper)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
                        <span>Gate Register</span>
                    }
                    else if (userRole == RoleConstants.CourtRecordsOfficer)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <span>Court Hearings</span>
                    }
                    else if (userRole == RoleConstants.PrisonerRecordsOfficer)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>Prisoners</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                        <span>Staff & Accounts</span>
                    }
                </div>
            </nav>
        </div>

        <!-- 2. Sign out Item at Bottom -->
        <div class="sidebar-bottom">
            <a href="/Account/Logout" class="sidebar-signout-btn" onclick="try{sessionStorage.clear();localStorage.clear();}catch(e){}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>Sign out</span>
            </a>
        </div>
    </aside>

    <!-- Main Workspace Area -->
    <div class="app-main">
        <header class="app-header">
            <div class="header-system-title">Prison Management Information System</div>
            <div class="header-user-badge">
                <div class="user-avatar-circle" title="@userRole">@initials</div>
                <div class="user-role-label">@userRole</div>
            </div>
        </header>

        <main class="workspace-content">
            @RenderBody()
        </main>
    </div>
</div>
