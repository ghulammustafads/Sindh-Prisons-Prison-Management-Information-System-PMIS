@if (!string.IsNullOrEmpty(ViewBag.StatusMessage as string) || !string.IsNullOrEmpty(Model?.StatusMessage as string))
{
    var msg = (ViewBag.StatusMessage as string) ?? Model?.StatusMessage;
    <div class="pmis-alert pmis-alert-success" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        <span>@msg</span>
    </div>
}

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string) || !string.IsNullOrEmpty(Model?.ErrorMessage as string))
{
    var err = (ViewBag.ErrorMessage as string) ?? Model?.ErrorMessage;
    <div class="pmis-alert pmis-alert-danger" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@err</span>
    </div>
}
